# TraceCore Environment Variables Example
# Duplicate as .env and adjust values for your deployment environment

ASPNETCORE_ENVIRONMENT=Development
# For any shared or production deployment, set ASPNETCORE_ENVIRONMENT=Production.
ASPNETCORE_URLS=http://+:5000

# SQL Server Configuration (never commit real values - set in .env / vault)
# MSSQL_PID must be a licensed edition for production (Standard, Enterprise). Developer is dev-only.
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=__SET_STRONG_SA_PASSWORD__
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=TraceCoreDb;User Id=sa;Password=__SET_STRONG_SA_PASSWORD__;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Redis Configuration
ConnectionStrings__Redis=redis:6379,abortConnect=false

# JWT Security Configuration (required: min 32 bytes, unique per environment)
JWT_SECRET_KEY=__SET_UNIQUE_JWT_SECRET_MIN_32_CHARS__
Jwt__Issuer=TraceCore.Api
Jwt__Audience=TraceCore.Client
Jwt__ExpiryMinutes=120

# First-startup admin bootstrap (production only, ignored once any user exists).
# Set for the initial boot, sign in, rotate credentials, then REMOVE the password.
# BOOTSTRAP_ADMIN_EMAIL=admin@tracecore.gov
# BOOTSTRAP_ADMIN_PASSWORD=__SET_ONE_TIME_ADMIN_PASSWORD__

# Storage
Storage__LocalPath=/app/data/storage
