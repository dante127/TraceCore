# TraceCore Environment Variables Example
# Duplicate as .env and adjust values for your deployment environment

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# SQL Server Configuration
SA_PASSWORD=TraceCoreSecureP@ssw0rd2026!
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=TraceCoreDb;User Id=sa;Password=TraceCoreSecureP@ssw0rd2026!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Redis Configuration
ConnectionStrings__Redis=redis:6379,abortConnect=false

# JWT Security Configuration
Jwt__SecretKey=TraceCoreSuperSecretKeyWithAtLeast32BytesForHmac256Security!
Jwt__Issuer=TraceCore.Api
Jwt__Audience=TraceCore.Client
Jwt__ExpiryMinutes=120

# Storage
Storage__LocalPath=/app/data/storage
